rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Public lead-capture forms (contact, callback, booking inquiry, newsletter, etc.)
    // Visitors can only CREATE a submission — never read, update, or delete existing ones.
    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'message', 'site', 'createdAt'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() < 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 5000
                    && request.resource.data.site is string
                    && request.resource.data.createdAt == request.time;
      allow read, update: if request.auth != null;
      allow delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
